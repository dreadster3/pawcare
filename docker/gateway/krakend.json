{
  "version": 3,
  "timeout": "3s",
  "output_encoding": "no-op",
  "endpoints": [
    {
      "endpoint": "/api/v1/owners",
      "method": "GET",
      "backend": [
        {
          "host": ["http://accounts"],
          "url_pattern": "/api/v1/owners",
          "encoding": "json"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://auth.pawcare.dev:8080/realms/pawcare/protocol/openid-connect/certs",
          "disable_jwk_security": true,
          "cache": true
        }
      },
      "input_headers": ["Authorization"]
    },
